# LLM API Keys for Medical Annotation
# =================================

# Google Gemini API Key (Primary - for gemini-2.5-flash and gemini-2.5-pro)
GOOGLE_API_KEY=your_google_api_key_here

# DeepSeek API Key (Alternative)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Instructions:
# 1. Copy this file to .env in the same directory
# 2. Replace the placeholder values with your actual API keys
# 3. Restart the Django server after making changes

# Note: You need at least one API key set for LLM annotation to work
# The system will prioritize Google API key, then fall back to DeepSeek

# Database Configuration
# =================================
# Set DB_ENGINE=mysql to use MySQL (used in Docker), leave unset for SQLite (local dev)
# DB_ENGINE=mysql
# DB_NAME=annotation_db
# DB_USER=annotation_user
# DB_PASSWORD=annotation_pass
# DB_HOST=localhost
# DB_PORT=3306